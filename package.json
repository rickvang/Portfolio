{
  "name": "rickvang-com",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.19.0",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "node scripts/test-e2e.mjs",
    "test:e2e:ui": "playwright test --ui",
    "seed": "node scripts/seed.mjs",
    "reset": "node scripts/reset.mjs",
    "supabase:start": "pnpm dlx supabase start",
    "supabase:reset": "pnpm dlx supabase db reset",
    "supabase:push": "pnpm dlx supabase db push",
    "supabase:types": "pnpm dlx supabase gen types typescript --local > src/lib/supabase/database.types.ts",
    "verify": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@supabase/ssr": "0.7.0",
    "@supabase/supabase-js": "2.57.4",
    "next": "15.5.24",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "4.1.11"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.3.1",
    "@playwright/test": "1.55.1",
    "@types/node": "24.3.0",
    "@types/react": "19.1.8",
    "@types/react-dom": "19.1.6",
    "eslint": "9.35.0",
    "eslint-config-next": "15.5.24",
    "typescript": "5.9.2",
    "vitest": "3.2.4"
  }
}
