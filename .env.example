# Public Supabase values are safe to expose only when Row Level Security is enabled.
# Never put a Supabase secret key in a NEXT_PUBLIC_ variable.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key

# The current foundation can run without Supabase configured. Set these when using the posts adapter.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
